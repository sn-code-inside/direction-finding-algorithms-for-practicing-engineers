function [] = recurA(A,x_val,y_val,N)
%recurA(A,x_val,y_val,N) Summary of this function goes here
%   Detailed explanation goes here
[Theta,R,yp] = A2ThetaR(A,x_val,y_val,N);
phat=inv(A'*A)*A'*yp;
rHat = sqrt(phat(1)*phat(1) + phat(2)*phat(2));
thHat = atan2(phat(2),phat(1));
[Pk Ek A1 A2,pk0]=recurEq(A,yp);
r = sqrt(A1.*A1 + A2.*A2); r0 = sqrt(pk0(1)^2 + pk0(2)^2)
th = atan2(A2,A1); 
th0 = atan2(pk0(2),pk0(1))

polarplot(Theta,R,'.',th,r,'^-r','MarkerFaceColor','r'); hold on;
polarplot(th0,r0,'o',thHat,rHat,'o','MarkerFaceColor','b'); hold off;
thetaticks([0 90 180]);
thetaticklabels({'x_1','x_2','-x_1'});
rticks([5 10]);
s1 = strMat(A); s2 = strMat(yp);
rmax =rlim;
text(145*pi/180,11,'${\bf{A}}$','interpreter','latex');
text(218*pi/180,0.7*rmax(2),[s1 ' $\pmatrix{x_1 \cr x_2}$ =' s2],...
    'interpreter','latex');
% phat
tha = [pi*0.9 thHat]; ra =[6 rHat];
[xaf yaf] = polarDS2nfu(tha,ra);
hT = annotation('textarrow',xaf,yaf,'Interpreter','latex','String', ...
            ['$\hat{\bf{p}}=$ (' num2str(phat(1),3) ',' ...
            num2str(phat(2),3) ')'],'color','blue','LineStyle','-.');
            hT.TextBackgroundColor = 'yellow';
% recursive
n = 8;
tha = [0.8*th(n) th(n)]; ra =[11 r(n)];
[xaf yaf] = polarDS2nfu(tha,ra);
hT = annotation('textarrow',xaf,yaf,'Interpreter','latex','String', ...
            ['$\hat{\bf{p}}_' num2str(n) '=$ (' num2str(A1(n),3) ',' ...
            num2str(A2(n),3) ')'],'color','blue','LineStyle','-.');
            hT.TextBackgroundColor = 'yellow';

end